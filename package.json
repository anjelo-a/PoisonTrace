{
  "name": "poisontrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript tooling for PoisonTrace project scripts and utilities",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "ts:run": "node --experimental-strip-types",
    "ts:fixtures": "node --experimental-strip-types scripts/ts/check-fixtures.ts",
    "perf": "npm run perf:load && npm run perf:web",
    "perf:load": "./scripts/perf_load_autocannon.sh",
    "perf:web": "./scripts/perf_frontend_lighthouse.sh",
    "web:dev": "npm run dev --workspace @poisontrace/web",
    "web:build": "npm run build --workspace @poisontrace/web",
    "web:typecheck": "npm run typecheck --workspace @poisontrace/web",
    "web:test": "npm run test --workspace @poisontrace/web",
    "contracts:typecheck": "npm run typecheck --workspace @poisontrace/contracts"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "autocannon": "^8.0.0",
    "lighthouse": "^13.3.0",
    "typescript": "^5.8.3"
  }
}
